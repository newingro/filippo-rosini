# URL canonico del sito (senza slash finale)
NEXT_PUBLIC_SITE_URL=https://studiorosini.it

# "true" SOLO dopo la revisione finale dei contenuti:
# - abilita l'indicizzazione (robots + meta)
# - nasconde le note "Da confermare" e la barra di anteprima
NEXT_PUBLIC_SITE_LIVE=false

# Invio email del modulo contatti (Resend – disponibile su Vercel Marketplace)
RESEND_API_KEY=
CONTACT_TO_EMAIL=f.rosini@studiorosini.it
CONTACT_FROM_EMAIL="Studio Rosini <sito@studiorosini.it>"

# Google Search Console (facoltativo): codice di verifica meta tag
GOOGLE_SITE_VERIFICATION=
